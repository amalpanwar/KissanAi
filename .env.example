# Data.gov.in
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24

# Google Geocoding
GOOGLE_GEOCODING_API_KEY=

# App URL for email verification/reset links
APP_BASE_URL=
AUTH_COOKIE_SECRET=

# Supabase Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
KISAANAI_HF_ONLINE=1

# SMTP email delivery for account verification and password reset OTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Default filters for commodity fetch/forecast
DATA_GOV_STATE=
DATA_GOV_DISTRICT=
DATA_GOV_COMMODITY=

# Optional paths
DATA_GOV_OUT_CSV=data/raw/live/datagov_commodity.csv
FORECAST_OUT_CSV=data/processed/forecast_15d.csv

# Agent coordinator and model planning (set 0 to use legacy routing)
KISAANAI_AGENTIC=1
KISAANAI_LLM_PLANNER=1
KISAANAI_MAX_NEW_TOKENS=512
# Optional larger planner/generator; benchmark on your hardware before enabling.
# KISAANAI_COMPLEX_GENERATOR_MODEL=Qwen/Qwen2.5-7B-Instruct
KISAANAI_QUERY_REFRESH_TIMEOUT=45

# Official market refresh: dashboard first, report fallback; keep two years.
AGMARKNET_MODE=auto
AGMARKNET_LOOKBACK_DAYS=14
AGMARKNET_KEEP_YEARS=2
AGMARKNET_MAX_AGE_DAYS=3
AGMARKNET_SLEEP_SEC=1.5
AGMARKNET_RUN_TIMEOUT_SEC=300
